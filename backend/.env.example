# Copy this file to .env and fill in real values. NEVER commit the real .env file.

# PostgreSQL connection string
DATABASE_URL="postgresql://username:password@localhost:5432/lunch_ordering?schema=public"

# JWT secrets - generate strong random values, e.g. `openssl rand -base64 48`
JWT_ACCESS_SECRET="replace-with-a-long-random-string"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-string"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# App
PORT=4000
NODE_ENV="development"

# Allowed frontend origin(s) for CORS - comma separated, no trailing slash
CORS_ORIGIN="http://localhost:5173"

# Cookie security
COOKIE_SECURE="false"
# set COOKIE_SECURE=true in production (requires HTTPS)

# Fixed lunch price fallback (Rs.)
DEFAULT_LUNCH_PRICE=275.00

# Self-registration - only emails ending in this domain can register.
# Leave blank only for local testing; ALWAYS set this in production.
ALLOWED_EMAIL_DOMAIN="yourcompany.com"

# Used to build the verification link sent by email
FRONTEND_URL="http://localhost:5173"

# SMTP settings for sending verification emails.
# If left unset, emails are printed to the server console instead (dev only).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="no-reply@yourcompany.com"
